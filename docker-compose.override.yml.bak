# docker-compose.override.yml
# Automatically loaded by `docker compose up` for LOCAL DEVELOPMENT.
# Overrides image pull with local builds and enables hot-reload volumes.

version: "3.9"

services:
  node-service:
    image: node-service:local
    build:
      context: ./node-service
    environment:
      NODE_ENV: development
    volumes:
      - ./node-service/src:/app/src   # hot-reload source
    command: ["npm", "run", "dev"]

  fastapi-service:
    image: fastapi-service:local
    build:
      context: social-media-agent
    environment:
      ENV: development
    volumes:
      - ./social-media-agent/app:/app/app  # hot-reload source
    command: ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]

  nextjs-app:
    image: nextjs-app:local
    build:
      context: ./nextjs-app
      target: deps           # stop at deps stage for dev
    environment:
      NODE_ENV: development
      NEXT_PUBLIC_NODE_API_URL: http://localhost:3001
      NEXT_PUBLIC_FASTAPI_URL: http://localhost:8080
    volumes:
      - ./nextjs-app:/app
      - /app/node_modules    # anonymous volume hides host node_modules
      - /app/.next           # anonymous volume hides .next build cache
    command: ["npm", "run", "dev"]
