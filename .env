# ── Copy this to .env and fill in your values ─────────────────────────────────

# GitHub Container Registry
GITHUB_ORG=em-hache
WH_GW_IMAGE=whatsapp-gw
WH_GW_TAG=latest
AGENT_IMAGE=social-media-agent
AGENT_TAG=latest
AGENT_WEB_IMAGE=social-media-agent-web
AGENT_WEB_TAG=latest

# PostgreSQL
POSTGRES_DB=appdb
POSTGRES_AGENT_USER=admin
POSTGRES_AGENT_PASSWORD=changeme
POSTGRES_GW_USER=admin
POSTGRES_GW_PASSWORD=changeme

# Runtime env
NODE_ENV=production
ENV=production
WHATSAPP_GW_URL=http://whatsapp-gw:3000
MAIN_SERVICE_URL=http://social-media-agent:8000

# Public URLs (browser-accessible)
NEXT_PUBLIC_WHATSAPP_GW_URL=http://localhost:3000
NEXT_PUBLIC_MAIN_SERVICE=http://localhost:8000

# social-media-agent service
SESSION_STORE=memory
DEBUG=false
LOG_LEVEL=INFO
