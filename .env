# ── Copy this to .env and fill in your values ─────────────────────────────────

# GitHub Container Registry
GITHUB_ORG=em-hache
WH_GW_IMAGE=whatsapp-gw
WH_GW_TAG=latest
AGENT_IMAGE=fastapi-service
AGENT_TAG=latest
# TODO
NEXTJS_IMAGE=nextjs-app
NEXTJS_TAG=latest

# PostgreSQL
POSTGRES_DB=appdb
POSTGRES_AGENT_USER=admin
POSTGRES_AGENT_PASSWORD=changeme
POSTGRES_GW_USER=admin
POSTGRES_GW_PASSWORD=changeme

# Runtime env
NODE_ENV=production
ENV=production

# Public URLs (browser-accessible)
NEXT_PUBLIC_NODE_API_URL=http://localhost:3001
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8080

# FastAPI service
ANTHROPIC_API_KEY=
WHATSAPP_API_KEY=
SESSION_TTL_SECONDS=3600
DEBUG=false
LOG_LEVEL=INFO