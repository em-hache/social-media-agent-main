# ── Copy this to .env.local and fill in your values ─────────────────────────────────

# JWT Authentication (shared between backend and frontend)
JWT_SECRET_KEY=jPhJXb7_HyrqV9hp5QREozQ1aO3On0Pe5haflDtYmU0
JWT_ALGORITHM=HS256

# GitHub Container Registry
GITHUB_ORG=em-hache
WH_GW_IMAGE=whatsapp-gw
WH_GW_TAG=latest
AGENT_IMAGE=social-media-agent
AGENT_TAG=latest
AGENT_WEB_IMAGE=social-media-agent-web
AGENT_WEB_TAG=latest

# PostgreSQL (local container)
POSTGRES_DB=appdb
POSTGRES_AGENT_USER=admin
POSTGRES_AGENT_PASSWORD=changeme
POSTGRES_URL=postgresql+asyncpg://admin:changeme@main-database:5432/appdb

# WhatsApp GW database connection (local container)
DB_HOST=main-database
DB_PORT=5432
DB_NAME=appdb
DB_USER=whatsapp_gw
DB_PASSWORD=whatsapp_gw_secret
DB_SSL=false
PGSSLMODE=disable

# DynamoDB (disabled locally)
DYNAMODB_ARCHIVE_ENABLED=false
DYNAMODB_TABLE_NAME=session_archive
DYNAMODB_REGION=eu-west-3

# Runtime env
NODE_ENV=production
ENV=production
WHATSAPP_GW_URL=http://whatsapp-gw:3000
MAIN_SERVICE_URL=http://social-media-agent:8000

# Public URLs (browser-accessible)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WHATSAPP_GW_URL=http://localhost:3000
NEXT_PUBLIC_MAIN_SERVICE=http://localhost:8000

# NextAuth
NEXTAUTH_URL=http://localhost:3005

# social-media-agent service
SESSION_STORE=memory
DEBUG=false
LOG_LEVEL=INFO
