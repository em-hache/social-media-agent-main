# ── Copy this to .env.local and fill in your values ─────────────────────────────────

# GitHub Container Registry
GITHUB_ORG=em-hache
WH_GW_IMAGE=whatsapp-gw
WH_GW_TAG=latest
AGENT_IMAGE=social-media-agent
AGENT_TAG=latest
AGENT_WEB_IMAGE=social-media-agent-web
AGENT_WEB_TAG=latest

# PostgreSQL (RDS)
POSTGRES_URL=postgresql+asyncpg://postgres:Buf4D8E53PuJ8649cHV7@social-media-agent.c30mcqcw641x.eu-west-3.rds.amazonaws.com:5432/social_media_agent

# WhatsApp GW database connection (RDS)
DB_HOST=social-media-agent.c30mcqcw641x.eu-west-3.rds.amazonaws.com
DB_PORT=5432
DB_NAME=social_media_agent
DB_USER=postgres
DB_PASSWORD=Buf4D8E53PuJ8649cHV7
DB_SSL=true
PGSSLMODE=require

# DynamoDB (enabled in production)
DYNAMODB_ARCHIVE_ENABLED=true
DYNAMODB_TABLE_NAME=session_archive
DYNAMODB_REGION=eu-west-3

# Runtime env
NODE_ENV=production
ENV=production
WHATSAPP_GW_URL=http://whatsapp-gw:3000
MAIN_SERVICE_URL=http://social-media-agent:8000

# Public URLs (browser-accessible)
NEXT_PUBLIC_WHATSAPP_GW_URL=http://15.236.144.208:3000
NEXT_PUBLIC_MAIN_SERVICE=http://15.236.144.208:8000

# NextAuth
NEXTAUTH_URL=http://15.236.144.208:3005

# social-media-agent service
SESSION_STORE=memory
DEBUG=false
LOG_LEVEL=INFO
WHISPER_MODEL=base
