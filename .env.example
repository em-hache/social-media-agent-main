# ── Copy this to .env and fill in your values ─────────────────────────────────

# GitHub Container Registry
GITHUB_ORG=your-org
WH_GW=node-service
NODE_TAG=latest
FASTAPI_IMAGE=fastapi-service
FASTAPI_TAG=latest
NEXTJS_IMAGE=nextjs-app
NEXTJS_TAG=latest

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb

# Runtime env
NODE_ENV=production
ENV=production

# Public URLs (browser-accessible)
NEXT_PUBLIC_NODE_API_URL=http://localhost:3001
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8080

# FastAPI service
ANTHROPIC_API_KEY=
WHATSAPP_API_KEY=
SESSION_TTL_SECONDS=3600
DEBUG=false
LOG_LEVEL=INFO